# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# Neon PostgreSQL – URL "pooled" (host có -pooler), ứng dụng dùng khi chạy.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"
# Neon PostgreSQL – URL "direct" (host không có -pooler), chỉ dùng cho prisma migrate.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Better Auth: chuỗi bí mật ≥ 32 ký tự. Tạo bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
# Địa chỉ gốc của website (local: http://localhost:3000, production: https://ten-du-an.vercel.app).
BETTER_AUTH_URL="http://localhost:3000"

# Chỉ dùng cho npm run db:seed: mật khẩu chung của các tài khoản demo (≥ 10 ký tự).
SEED_PASSWORD="REPLACE_WITH_A_DEMO_PASSWORD"

# Chỉ dùng cho npm run test:e2e: MỘT DATABASE RIÊNG, bị xoá và seed lại mỗi lần chạy E2E.
# Tuyệt đối không trỏ vào database phát triển hay production.
E2E_DATABASE_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE_E2E?sslmode=require"
